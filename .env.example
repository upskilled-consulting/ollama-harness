# Ollama
OLLAMA_HOST=http://localhost:11434

# Models
PRODUCER_MODEL=pi-qwen3.6
EVALUATOR_MODEL=Qwen3-Coder:30b
VISION_MODEL=llama3.2-vision
EMBED_MODEL=nomic-embed-text

# Thresholds
PASS_THRESHOLD=8.0
WIGGUM_MAX_ROUNDS=3
SUBTASK_MAX_WORKERS=4

# Feature flags
RESEARCH_CACHE=1
WIGGUM_PANEL=0

# Semantic Scholar
SEMANTIC_SCHOLAR_API_KEY=

# Server
PORT=7860
HOST=0.0.0.0
