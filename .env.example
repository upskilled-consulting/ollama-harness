# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_KEEP_ALIVE=-1

# Models (pydantic-settings defaults — override here)
PRODUCER_MODEL=pi-qwen3.6
EVALUATOR_MODEL=Qwen3-Coder:30b
VISION_MODEL=llama3.2-vision
EMBED_MODEL=nomic-embed-text

# Inference routing — per-model endpoint map (takes priority over INFERENCE_BACKEND)
# Example: llama-server for the 35B model on port 8083
# HARNESS_ENDPOINTS={"qwen3.6-35b": {"url": "http://localhost:8083/v1", "model_id": "Qwen3.6-35B-A3B-UD-IQ3_S.gguf", "backend": "llamacpp"}}
HARNESS_PRODUCER_MODEL=qwen3.6-35b

# Wiggum model overrides (default: HARNESS_PRODUCER_MODEL)
# WIGGUM_PRODUCER_MODEL=qwen3.6-35b
# WIGGUM_EVALUATOR_MODEL=qwen3.6-35b
# Must differ from HARNESS_PRODUCER_MODEL — same-model eval is circular
HARNESS_EVALUATOR_MODEL=qwen3-14b
# Optional: comma-separated pool; each run draws one evaluator by hash for rotation
# HARNESS_EVALUATOR_POOL=qwen3-14b,gemma4-27b

# Thresholds
PASS_THRESHOLD=8.0
WIGGUM_MAX_ROUNDS=3
SUBTASK_MAX_WORKERS=4

# Feature flags
RESEARCH_CACHE=1
WIGGUM_PANEL=0

# Semantic Scholar
SEMANTIC_SCHOLAR_API_KEY=

# PyPI publishing
PYPI_API_TOKEN=

# Email skill
# SENDER_NAME=
# SENDER_EMAIL=
# SENDER_COMPANY=

# MCP server
# MCP_MAX_CONCURRENCY=3
# MCP_SERVER_PORT=8766

# Server
PORT=7860
HOST=0.0.0.0
